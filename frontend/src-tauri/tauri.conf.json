{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ghost",
  "version": "1.1.0",
  "identifier": "com.ghost.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:tauri"
  },
  "app": {
    "windows": [
      {
        "title": "Ghost",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src 'self' http: https: ws: wss:; img-src 'self' data: blob:; media-src 'self' blob: asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$RESOURCE/stonic/video/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "Utility",
    "shortDescription": "On-device AI assistant with energy monitoring and trace debugging",
    "longDescription": "Ghost Desktop wraps the Ghost research framework in a native desktop application with real-time energy monitoring, trace debugging, learning curve visualization, and memory browsing.",
    "macOS": {
      "entitlements": "Entitlements.plist",
      "minimumSystemVersion": "10.15",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installerHooks": "./windows/installer-hooks.nsh"
      },
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com"
    },
    "resources": {
      "../../pyproject.toml": "backend/pyproject.toml",
      "../../uv.lock": "backend/uv.lock",
      "../../README.md": "backend/README.md",
      "../../LICENSE": "backend/LICENSE",
      "../../src/": "backend/src/",
      "../../configs/": "backend/configs/",
      "../../rust/Cargo.toml": "backend/rust/Cargo.toml",
      "../../rust/Cargo.lock": "backend/rust/Cargo.lock",
      "../../rust/rust-toolchain.toml": "backend/rust/rust-toolchain.toml",
      "../../rust/crates/": "backend/rust/crates/",
      "../../scripts/install/": "backend/scripts/install/",
      "../../deploy/windows/": "backend/deploy/windows/",
      "resources/stonic/video/": "stonic/video/"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "pubkey": "",
      "endpoints": [
        "https://github.com/hamz5ashah/Ghost/releases/download/desktop-latest/latest.json"
      ]
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "ghost"
        ]
      }
    }
  }
}
